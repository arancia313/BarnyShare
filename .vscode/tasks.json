{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start BarnyShare Server",
      "type": "shell",
      "command": "cd ${workspaceFolder}/server && npm install && npm start",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*$",
          "endsPattern": "Server su"
        }
      }
    }
  ]
}